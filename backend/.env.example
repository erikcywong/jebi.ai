# DeepSeek 接入
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# DeepSeek 成本（人民币/百万 token）——以官方价格页为准，调价时更新
PRICE_INPUT_PER_M_CNY=1.95
PRICE_OUTPUT_PER_M_CNY=7.95
PRICE_CACHE_HIT_RATIO=0.26

# JBP 锚定与定价策略（修正点 A2）
JBP_ANCHOR_CNY=0.1
C_BUNDLE_MARKUP=3.0
C_PAYG_MARKUP=3.0
C_PAYG_MIN_JBP=10
B_MARKUP=5.0
B_CALL_BASE_JBP=50

# 运营与合规（修正点 B2：预付卡约束）
AI_TIMEOUT_S=20
JBP_DB_PATH=jebi.db
TOPUP_SINGLE_LIMIT_JBP=10000
TOPUP_BALANCE_CAP_JBP=50000
REFUND_COOLING_DAYS=7
